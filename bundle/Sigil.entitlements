<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime blocks Apple Events unless this is declared. Sigil asks the frontmost
         browser for its active tab URL to check it against the Visual-mode blocklist. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
